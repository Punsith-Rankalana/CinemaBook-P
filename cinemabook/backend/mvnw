#!/bin/sh
# Maven Wrapper Script
# Licensed to the Apache Software Foundation (ASF)

set -e

# Determine the project base dir
findBaseDir () {
  EXEC_DIR="$PWD"
  WDIR="$PWD"
  while [ "$WDIR" != '/' ] ; do
    if [ -d "$WDIR"/.mvn ] ; then
      BASE_DIR="$WDIR"
      return
    fi
    WDIR=$(dirname "$WDIR")
  done
  BASE_DIR="$EXEC_DIR"
}

findBaseDir

MAVEN_PROJECTBASEDIR="${BASE_DIR}"
MAVEN_OPTS="${MAVEN_OPTS:-}"

# Download Maven wrapper jar if not present
WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_LAUNCHER="org.apache.maven.wrapper.MavenWrapperMain"
WRAPPER_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar"

if [ -r "$WRAPPER_JAR" ]; then
  echo "Maven wrapper jar found."
else
  echo "Downloading Maven wrapper jar..."
  if command -v wget > /dev/null; then
    wget -q -O "$WRAPPER_JAR" "$WRAPPER_URL"
  elif command -v curl > /dev/null; then
    curl -sL -o "$WRAPPER_JAR" "$WRAPPER_URL"
  else
    echo "ERROR: Neither wget nor curl is available to download maven-wrapper.jar"
    exit 1
  fi
fi

exec "$JAVA_HOME/bin/java" \
  $MAVEN_OPTS \
  -classpath "$WRAPPER_JAR" \
  "-Dmaven.multiModuleProjectDirectory=${MAVEN_PROJECTBASEDIR}" \
  "$WRAPPER_LAUNCHER" "$@"
